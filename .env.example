# ==============================================================================
# Modelo de variaveis de ambiente para o Docker Compose (API + PostgreSQL)
# 1. Copie este arquivo para ".env" na raiz do projeto (api-cursos/.env).
# 2. Defina uma senha em POSTGRES_PASSWORD.
# 3. NUNCA envie o arquivo ".env" real ao GitHub (ja protegido no .gitignore).
# ==============================================================================

# Perfil ativo da aplicacao no container (prod = sem show-sql e /actuator/health protegido)
SPRING_PROFILES_ACTIVE=prod

# Porta HTTP exposta na maquina host para a API
API_PORT=8080

# Porta do PostgreSQL exposta na maquina host (altere se a 5432 ja estiver ocupada localmente)
POSTGRES_PORT=5432

# Configuracao do PostgreSQL (lida pelo servico "db" e reaproveitada pelo servico "api")
POSTGRES_DB=api_cursos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina_sua_senha_aqui
